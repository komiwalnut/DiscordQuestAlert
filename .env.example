# Your Discord user token (from browser DevTools → Network → any API request → Authorization header)
USER_TOKEN=

# Discord webhook URL for the channel that receives quest alerts
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# Upstash Redis credentials (free at upstash.com → Create Database → REST API tab)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How often to check for new quests (default: 10 minutes)
POLL_INTERVAL_MINUTES=10
